<mxfile host="drawio"><diagram id="段階1 EC2の1台" name="段階1 EC2の1台"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="段階1　EC2 の1台で SQLite と Litestream を動かす（月 21.36 ドル）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="aws" value="AWS 東京リージョン（ap-northeast-1）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#232F3E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="180" y="50" width="1000" height="610" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;ログ・EMF の指標・アラーム" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="40" width="280" height="60" as="geometry"/></mxCell><mxCell id="ops" value="運用者" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1210" y="200" width="120" height="50" as="geometry"/></mxCell><mxCell id="ssm" value="Systems Manager&lt;br&gt;Session Manager" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="150" width="280" height="50" as="geometry"/></mxCell><mxCell id="role" value="インスタンスロール&lt;br&gt;CloudWatchAgentServerPolicy&lt;br&gt;AmazonSSMManagedInstanceCore&lt;br&gt;複製先のバケットへの読み書きと削除&lt;br&gt;（版の削除は与えない）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="230" width="280" height="100" as="geometry"/></mxCell><mxCell id="le" value="Let's Encrypt&lt;br&gt;（証明書の発行と更新）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="140" height="60" as="geometry"/></mxCell><mxCell id="users" value="利用者&lt;br&gt;（ブラウザ）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="205" width="140" height="60" as="geometry"/></mxCell><mxCell id="vpc" value="VPC" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="aws"><mxGeometry x="20" y="40" width="640" height="430" as="geometry"/></mxCell><mxCell id="igw" value="インターネット&lt;br&gt;ゲートウェイ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F1EAFE;strokeColor=#8C4FFF;" vertex="1" parent="vpc"><mxGeometry x="15" y="115" width="110" height="60" as="geometry"/></mxCell><mxCell id="pub" value="パブリックサブネット（AZ a）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#EEF6E8;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="150" y="30" width="470" height="380" as="geometry"/></mxCell><mxCell id="sg" value="セキュリティグループ　受信は 443 と 80 だけ、22 は開けない" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#DD344C;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontColor=#B0283C;container=1;collapsible=0;" vertex="1" parent="pub"><mxGeometry x="15" y="35" width="440" height="230" as="geometry"/></mxCell><mxCell id="ec2" value="EC2 t4g.small（Arm、2 vCPU、2GiB）Elastic IP&lt;br&gt;firstline（HTTPS 443、certbot 80）&lt;br&gt;Litestream、CloudWatch Agent、SSM Agent" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFF1E3;strokeColor=#ED7100;" vertex="1" parent="sg"><mxGeometry x="15" y="35" width="410" height="90" as="geometry"/></mxCell><mxCell id="ebs" value="EBS gp3 20GB（暗号化）&lt;br&gt;SQLite の WriteDB と ReadDB" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#EEF6E8;strokeColor=#3F8624;" vertex="1" parent="sg"><mxGeometry x="215" y="145" width="210" height="70" as="geometry"/></mxCell><mxCell id="vpce" value="S3 のゲートウェイ型 VPC エンドポイント（料金なし）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F1EAFE;strokeColor=#8C4FFF;" vertex="1" parent="pub"><mxGeometry x="15" y="290" width="440" height="50" as="geometry"/></mxCell><mxCell id="s3" value="S3 バケット（東京、公開をブロック）&lt;br&gt;Litestream の複製。バージョニングを有効&lt;br&gt;古い版は 30 日後に規則で消す" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#EEF6E8;strokeColor=#3F8624;" vertex="1" parent="aws"><mxGeometry x="690" y="360" width="280" height="70" as="geometry"/></mxCell><mxCell id="note" value="置かないもの　ALB、NAT ゲートウェイ、踏み台、22 番の受信&lt;br&gt;月額　t4g.small 15.768 ＋ 公開 IPv4 3.65 ＋ gp3 20GB 1.92 ＋ S3 1GB 0.025 ＝ 21.36 ドル&lt;br&gt;外向きの通信は全サービスで月 100GB まで無料（以後 0.114 ドル/GB）&lt;br&gt;段の中の調整　インスタンスを t4g.medium（4GiB）に上げてよい。上げたら ADR-0003 の手順で限界負荷を測り直す" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF9DB;strokeColor=#B59A00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="aws"><mxGeometry x="20" y="490" width="950" height="100" as="geometry"/></mxCell><mxCell id="e17" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="HTTP 80（検証）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="le" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="443 / 80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="igw" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="fsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="ebs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="Litestream（ロールで署名）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="vpce"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="WAL の複製" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="vpce" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="ログと EMF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="SSM Agent が外向きに接続" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="ssm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="コンソールか CLI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="ssm"><mxGeometry relati