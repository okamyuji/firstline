<mxfile host="drawio"><diagram id="段階3 ECS on FargateとALB" name="段階3 ECS on FargateとALB"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="段階3　ALB と ECS on Fargate で複数台にする（月 164.81 ドル）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="aws" value="AWS 東京リージョン（ap-northeast-1）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#232F3E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="180" y="50" width="1000" height="730" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;ログ・EMF の指標・アラーム" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="40" width="280" height="60" as="geometry"/></mxCell><mxCell id="ops" value="運用者" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1210" y="160" width="120" height="50" as="geometry"/></mxCell><mxCell id="ssm" value="Systems Manager&lt;br&gt;（ECS Exec）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="105" width="280" height="50" as="geometry"/></mxCell><mxCell id="ecr" value="ECR&lt;br&gt;firstline のイメージ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFF1E3;strokeColor=#ED7100;" vertex="1" parent="aws"><mxGeometry x="690" y="220" width="280" height="50" as="geometry"/></mxCell><mxCell id="acm" value="ACM&lt;br&gt;ALB の証明書" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="165" width="280" height="50" as="geometry"/></mxCell><mxCell id="pre" value="移る前に直すこと&lt;br&gt;1. ALB の後ろでは X-Forwarded-For の末尾を利用者の IP にする（ALB は既定の append）&lt;br&gt;2. 定期の処理を止める設定を足し、定期の処理だけのタスクを 1 つ置く&lt;br&gt;3. ログインと保留の回数を DB で数える&lt;br&gt;4. FIRSTLINE_INVENTORY=db にする&lt;br&gt;5. 起動時に自己署名の証明書を作る" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF9DB;strokeColor=#B59A00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="aws"><mxGeometry x="690" y="300" width="280" height="175" as="geometry"/></mxCell><mxCell id="users" value="利用者&lt;br&gt;（ブラウザ）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="140" height="60" as="geometry"/></mxCell><mxCell id="vpc" value="VPC" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="aws"><mxGeometry x="20" y="40" width="640" height="550" as="geometry"/></mxCell><mxCell id="igw" value="インターネット&lt;br&gt;ゲートウェイ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F1EAFE;strokeColor=#8C4FFF;" vertex="1" parent="vpc"><mxGeometry x="15" y="95" width="110" height="60" as="geometry"/></mxCell><mxCell id="puba" value="パブリックサブネット（AZ a）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#EEF6E8;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="150" y="30" width="225" height="310" as="geometry"/></mxCell><mxCell id="pubc" value="パブリックサブネット（AZ c）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#EEF6E8;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="395" y="30" width="225" height="310" as="geometry"/></mxCell><mxCell id="alb" value="ALB（2 つの AZ）　SG は 443 を外へ開く" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F1EAFE;strokeColor=#8C4FFF;" vertex="1" parent="vpc"><mxGeometry x="165" y="100" width="440" height="50" as="geometry"/></mxCell><mxCell id="weba" value="Web のタスク&lt;br&gt;1 vCPU、2GB、公開 IP&lt;br&gt;定期の処理は止める" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFF1E3;strokeColor=#ED7100;" vertex="1" parent="puba"><mxGeometry x="15" y="140" width="195" height="70" as="geometry"/></mxCell><mxCell id="jobs" value="定期の処理のタスク&lt;br&gt;0.25 vCPU、0.5GB、公開 IP" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFF1E3;strokeColor=#ED7100;" vertex="1" parent="puba"><mxGeometry x="15" y="230" width="195" height="60" as="geometry"/></mxCell><mxCell id="webc" value="Web のタスク&lt;br&gt;1 vCPU、2GB、公開 IP&lt;br&gt;定期の処理は止める" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFF1E3;strokeColor=#ED7100;" vertex="1" parent="pubc"><mxGeometry x="15" y="140" width="195" height="70" as="geometry"/></mxCell><mxCell id="priva" value="プライベートサブネット（AZ a）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8F2F9;strokeColor=#147EBA;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="150" y="360" width="225" height="170" as="geometry"/></mxCell><mxCell id="privc" value="プライベートサブネット（AZ c）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8F2F9;strokeColor=#147EBA;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="395" y="360" width="225" height="170" as="geometry"/></mxCell><mxCell id="rds" value="RDS for PostgreSQL&lt;br&gt;Multi-AZ のプライマリ&lt;br&gt;5432 はタスクの SG からだけ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F7E8FA;strokeColor=#C925D1;" vertex="1" parent="priva"><mxGeometry x="15" y="40" width="195" height="90" as="geometry"/></mxCell><mxCell id="standby" value="Multi-AZ のスタンバイ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFFFFF;strokeColor=#C925D1;dashed=1;" vertex="1" parent="privc"><mxGeometry x="15" y="55" width="195" height="60" as="geometry"/></mxCell><mxCell id="note" value="移る条件　段階2で測った購入の経路の限界負荷の 50% を超えたとき、またはアプリのホストの故障で止まる時間を要件が許さないとき&lt;br&gt;月額　ALB 17.74 ＋ ALB の IPv4 7.30 ＋ 1 LCU 5.84 ＋ Web 2 つ 71.96 ＋ 定期 1 つ 9.00 ＋ タスクの IPv4 10.95 ＋ RDS Multi-AZ 36.50 ＋ gp3 5.52 ＝ 164.81 ドル&lt;br&gt;置かないもの　NAT ゲートウェイ（タスクは公開 IP で ECR から取り、SG で ALB からの通信だけを受ける）&lt;br&gt;ALB からタスクへは HTTPS。ALB は転送先の証明書を検証しないので、タスクは自己署名の証明書で受ける。ヘルスチェックは / を使う" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF9DB;strokeColor=#B59A00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="aws"><mxGeometry x="20" y="610" width="950" height="100" as="geometry"/></mxCell><mxCell id="e22" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="igw" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="weba"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="webc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="weba" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="jobs" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="webc" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="同期複製" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rds" target="standby"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="証明書" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="acm" target="alb"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell><mxCell id="e31" value="イメージの取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecr" target="webc"><mxGeometry x="-0.4" relative="1" as="geometry"/></mxCell><mxCell id="e32" value="全タスクの awslogs と EMF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.05;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pubc" target="cw"><mxGeometry x="0.3" relative="1" as="geometry"/></mxCell><mxCell id="e33" value="ECS Exec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="ssm"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>