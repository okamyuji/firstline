<mxfile host="drawio"><diagram id="段階2 RDS for PostgreSQL" name="段階2 RDS for PostgreSQL"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="段階2　DB を RDS for PostgreSQL に移す（単一 AZ で月 42.35 ドル、Multi-AZ で 63.36 ドル）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell><mxCell id="aws" value="AWS 東京リージョン（ap-northeast-1）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#232F3E;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="180" y="50" width="1000" height="640" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;ログ・EMF の指標・アラーム" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="40" width="280" height="60" as="geometry"/></mxCell><mxCell id="ops" value="運用者" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1210" y="200" width="120" height="50" as="geometry"/></mxCell><mxCell id="ssm" value="Systems Manager&lt;br&gt;Session Manager" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FCE8F2;strokeColor=#E7157B;" vertex="1" parent="aws"><mxGeometry x="690" y="150" width="280" height="50" as="geometry"/></mxCell><mxCell id="le" value="Let's Encrypt&lt;br&gt;（証明書の発行と更新）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="140" height="60" as="geometry"/></mxCell><mxCell id="users" value="利用者&lt;br&gt;（ブラウザ）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="140" height="60" as="geometry"/></mxCell><mxCell id="vpc" value="VPC" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="aws"><mxGeometry x="20" y="40" width="640" height="460" as="geometry"/></mxCell><mxCell id="igw" value="インターネット&lt;br&gt;ゲートウェイ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F1EAFE;strokeColor=#8C4FFF;" vertex="1" parent="vpc"><mxGeometry x="15" y="110" width="110" height="60" as="geometry"/></mxCell><mxCell id="pub" value="パブリックサブネット（AZ a）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#EEF6E8;strokeColor=#7AA116;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="150" y="30" width="470" height="170" as="geometry"/></mxCell><mxCell id="sg" value="セキュリティグループ　受信は 443 と 80 だけ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#DD344C;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontColor=#B0283C;container=1;collapsible=0;" vertex="1" parent="pub"><mxGeometry x="15" y="35" width="440" height="120" as="geometry"/></mxCell><mxCell id="ec2" value="EC2 t4g.small（Elastic IP）firstline（HTTPS 443、certbot 80）&lt;br&gt;FIRSTLINE_STORE=postgres。CloudWatch Agent、SSM Agent。Litestream は止める" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFF1E3;strokeColor=#ED7100;" vertex="1" parent="sg"><mxGeometry x="15" y="35" width="410" height="70" as="geometry"/></mxCell><mxCell id="priva" value="プライベートサブネット（AZ a）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8F2F9;strokeColor=#147EBA;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="150" y="230" width="225" height="210" as="geometry"/></mxCell><mxCell id="privc" value="プライベートサブネット（AZ c）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#E8F2F9;strokeColor=#147EBA;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;" vertex="1" parent="vpc"><mxGeometry x="395" y="230" width="225" height="210" as="geometry"/></mxCell><mxCell id="rdssg" value="RDS の SG&lt;br&gt;5432 は EC2 の SG からだけ" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=none;strokeColor=#DD344C;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontColor=#B0283C;container=1;collapsible=0;" vertex="1" parent="priva"><mxGeometry x="10" y="35" width="205" height="160" as="geometry"/></mxCell><mxCell id="rds" value="RDS for PostgreSQL&lt;br&gt;db.t4g.micro&lt;br&gt;公開アクセスなし" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#F7E8FA;strokeColor=#C925D1;" vertex="1" parent="rdssg"><mxGeometry x="10" y="50" width="185" height="90" as="geometry"/></mxCell><mxCell id="standby" value="Multi-AZ のスタンバイ&lt;br&gt;（復旧時点の要件で移るとき）" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#FFFFFF;strokeColor=#C925D1;dashed=1;" vertex="1" parent="privc"><mxGeometry x="20" y="85" width="185" height="80" as="geometry"/></mxCell><mxCell id="s3" value="S3 バケット（東京）&lt;br&gt;段階1の複製を移行の記録として残す" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#EEF6E8;strokeColor=#3F8624;" vertex="1" parent="aws"><mxGeometry x="690" y="380" width="280" height="60" as="geometry"/></mxCell><mxCell id="note" value="移る条件　ADR-0003 の移る条件のどれか。移行は ADR-0003 のデータ移行の手順で行う&lt;br&gt;月額　EC2 21.34 ＋ db.t4g.micro 18.25 ＋ gp3 20GB 2.76 ＝ 42.35 ドル（Multi-AZ は 63.36 ドル）&lt;br&gt;置かないもの　ALB、NAT ゲートウェイ（RDS は外へ出る通信を要らない）&lt;br&gt;段の中の調整　RDS を db.t4g.small に上げてよい" style="whiteSpace=wrap;html=1;fontSize=12;rounded=0;fillColor=#FFF9DB;strokeColor=#B59A00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="aws"><mxGeometry x="20" y="520" width="950" height="100" as="geometry"/></mxCell><mxCell id="e19" value="HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="HTTP 80（検証）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="le" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="443 / 80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="igw" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="5432（TLS）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="rds"><mxGeometry x="-0.6" relative="1" as="geometry"/></mxCell><mxCell id="e23" value="同期複製" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rds" target="standby"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="ログと EMF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="SSM Agent が外向きに接続" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ec2" target="ssm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="コンソールか CLI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="ssm"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>