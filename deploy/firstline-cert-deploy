#!/usr/bin/env bash
# certbot --deploy-hook: install the renewed certificate and ask firstline to reload it.
set -euo pipefail

src=${RENEWED_LINEAGE:?RENEWED_LINEAGE is not set}
# FIRSTLINE_TLS_DIR exists for scripts/deploy_test.sh; certbot never sets it.
dest=${FIRSTLINE_TLS_DIR:-/etc/firstline/tls}

for name in fullchain.pem privkey.pem; do
	# The temp file is created 0600 so the private key is never readable by others.
	install -m 0600 -o firstline "$src/$name" "$dest/$name.new"
	mv "$dest/$name.new" "$dest/$name"
done

systemctl try-reload-or-restart firstline
