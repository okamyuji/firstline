# Copy to /etc/firstline/env (mode 0600, owner firstline). Each variable with a
# default shows it. FIRSTLINE_TOKEN_KEY and FIRSTLINE_BASE_URL have no default:
# replace both before the first start.
FIRSTLINE_STORE=sqlite
FIRSTLINE_DB_PATH=/var/lib/firstline/firstline.db
# FIRSTLINE_DSN is required only when FIRSTLINE_STORE is postgres or mysql.
# FIRSTLINE_DSN=not-a-real-dsn
FIRSTLINE_INVENTORY=memory
FIRSTLINE_ADDR=:443
FIRSTLINE_TLS_CERT=/etc/firstline/tls/fullchain.pem
FIRSTLINE_TLS_KEY=/etc/firstline/tls/privkey.pem
# Generate the key with: openssl rand -base64 48
FIRSTLINE_TOKEN_KEY=replace-with-the-openssl-rand-output
FIRSTLINE_BASE_URL=https://tickets.example.com
FIRSTLINE_ERROR_REPORTER=log
FIRSTLINE_METRICS=emf
FIRSTLINE_EMF_ADDR=127.0.0.1:25888
FIRSTLINE_ADMIN_ADDR=127.0.0.1:9090
FIRSTLINE_ADMIN_SOCK=/run/firstline/admin.sock
FIRSTLINE_LOCK_PATH=/var/lib/firstline/firstline.lock
FIRSTLINE_HOLD_RATE_PER_MIN=10
FIRSTLINE_FAKE_PAYMENT_DELAY=3s
FIRSTLINE_FAKE_PAYMENT_OUTCOME=complete
