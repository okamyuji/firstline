[Unit]
Description=firstline ticket sales
After=network-online.target
Wants=network-online.target

[Service]
User=firstline
EnvironmentFile=/etc/firstline/env
ExecStart=/usr/local/bin/firstline serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/firstline/app.log
RuntimeDirectory=firstline
LogsDirectory=firstline
ProtectSystem=strict
ReadWritePaths=/var/lib/firstline
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
